# ---------------------------------------------------------------------------
# SIH26107 backend configuration. Copy to .env and adjust.
# ---------------------------------------------------------------------------
APP_ENV=development

# --- Database --------------------------------------------------------------
# MongoDB is the only database. MONGO_URI is read from this file, which is
# git-ignored - never hard-code it in source.
# Atlas connection strings carry no database name, so it is set separately.
MONGO_DB_NAME=sih26107
# Server-selection timeout (ms). Kept short so a dropped network fails fast
# with a clear 503 instead of hanging the request.
MONGO_TIMEOUT_MS=8000
MONGO_URI=mongodb+srv://amrutprakash93_db_user:6pHmOsKAezcxCja2@bisfinal.xdkieac.mongodb.net/
# --- LLM provider ----------------------------------------------------------
# Leave LLM_API_KEY empty to run in deterministic retrieval-only mode: search,
# clause retrieval, regulatory lookup and gap analysis all keep working.
# LLM_PROVIDER: auto | openai | anthropic | gemini
LLM_PROVIDER=gemini
LLM_API_KEY=AIzaSyAb8RN6LuIan3NRcnFXfnqrufhdkH-N27NJXwkrn-nAuciMVYUA
LLM_MODEL=gemini-1.5-flash
LLM_TIMEOUT_SECONDS=60
# With LLM_PROVIDER=auto these are picked up automatically if set:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# --- Retrieval -------------------------------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2
# auto | sentence-transformers | hashing   (hashing needs no model download)
EMBEDDING_BACKEND=auto
# Vectors are stored in MongoDB alongside the corpus. Atlas Vector Search is
# used when its indexes are queryable, otherwise brute-force cosine over the
# same vectors - /api/health reports which is active.

# Hybrid fusion weights - tuning knobs, not scientific constants.
WEIGHT_SEMANTIC=0.60
WEIGHT_BM25=0.30
WEIGHT_METADATA=0.10
DISCOVERY_CANDIDATE_LIMIT=8
CLAUSE_TOP_K=8

# --- Web -------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
MAX_UPLOAD_MB=15

# --- OCR (consumer label scanning) ------------------------------------------
# auto | off. "auto" uses Tesseract when it is installed and degrades to
# "OCR unavailable" (never a fabricated result) when it is not.
OCR_BACKEND=auto
# Path to the tesseract executable. Leave empty to auto-detect a Windows
# install; set explicitly for a non-standard install location, e.g. in a
# container: TESSERACT_CMD=/usr/bin/tesseract
TESSERACT_CMD=

# --- Dynamic Search (NEW - Required for live BIS knowledge retrieval) ------
# Get free API key at https://serper.dev (2,500 searches/month free)
SERPER_API_KEY=77ddfe34b949511614a23418ed81445d9f200374

# Gemini API key - get at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyAb8RN6LuIan3NRcnFXfnqrufhdkH-N27NJXwkrn-nAuciMVYUA

# Search cache TTL in seconds (default 1 hour)
SEARCH_CACHE_TTL=3600
