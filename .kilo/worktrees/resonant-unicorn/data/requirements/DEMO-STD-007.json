      "check_rule": {
        "attribute": "shell_material",
        "operator": "not_empty"
      }
    },
    {
      "requirement_code": "D7-R02",
      "clause": "4.2.2",
      "category": "material",
      "requirement_text": "The density and thickness of the protective padding shall be declared and a material certificate held for each batch.",
      "evidence_type": "material_certificate",
      "severity": "major",
      "match_keywords": [
        "eps",
        "padding",
        "liner density",
        "expanded polystyrene"
