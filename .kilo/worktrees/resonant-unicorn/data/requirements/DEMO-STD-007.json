{
  "standard_id": "DEMO-STD-007",
  "note": "Structured requirements curated from the demo protective helmet specification.",
  "requirements": [
    {
      "requirement_code": "D7-R01",
      "clause": "4.1.1",
      "category": "material",
      "requirement_text": "The shell shall be of thermoplastic or thermoset composite that does not degrade under ultraviolet radiation, temperature variation or contact with petrol, oil and cleaning agents.",
      "evidence_type": "material_certificate",
      "severity": "major",
      "match_keywords": [
        "shell material",
        "abs",
        "polycarbonate",
        "composite",
        "material certificate"
