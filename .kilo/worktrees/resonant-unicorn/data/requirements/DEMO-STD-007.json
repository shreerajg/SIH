      "check_rule": {
        "attribute": "liner_density_kg_m3",
        "operator": "not_empty"
      }
    },
    {
      "requirement_code": "D7-R03",
      "clause": "4.4.1",
      "category": "performance",
      "requirement_text": "Full face helmet mass shall not exceed 1.5 kg; open face or half coverage helmet mass shall not exceed 1.2 kg.",
      "evidence_type": "declared_value",
      "severity": "major",
      "match_keywords": [
        "helmet mass",
        "weight",
        "kg"
      ],
      "check_rule": {
        "attribute": "mass_kg",
        "operator": "lte",
        "value": 1.5,
        "unit": "kg"
      }
    },
    {
      "requirement_code": "D7-R04",
      "clause": "5.1.1",
      "category": "testing",
      "requirement_text": "Peak acceleration transmitted to the headform shall not exceed 300 g and shall not exceed 150 g for more than 5 milliseconds cumulatively.",
      "evidence_type": "test_report",
      "severity": "critical",
      "match_keywords": [
        "impact absorption",
        "peak acceleration",
        "300 g",
        "shock absorption"
      ]
    },
    {
      "requirement_code": "D7-R05",
      "clause": "5.2.1",
      "category": "testing",
      "requirement_text": "In the penetration test the striker shall not contact the surface of the headform.",
      "evidence_type": "test_report",
      "severity": "critical",
      "match_keywords": [
        "penetration",
        "striker",
        "puncture"
      ]
    },
    {
      "requirement_code": "D7-R06",
      "clause": "5.3.1",
      "category": "testing",
      "requirement_text": "Retention system dynamic displacement shall not exceed 35 mm and residual displacement shall not exceed 25 mm, without failure.",
      "evidence_type": "test_report",
      "severity": "critical",
      "match_keywords": [
        "retention system",
        "chin strap",
        "strap strength",
        "displacement"
      ]
    },
    {
      "requirement_code": "D7-R07",
      "clause": "5.4.1",
      "category": "testing",
      "requirement_text": "The helmet shall not roll off the headform in the roll-off test.",
      "evidence_type": "test_report",
      "severity": "critical",
      "match_keywords": [
        "roll off",
        "roll-off",
        "retention"
      ]
    },
    {
      "requirement_code": "D7-R08",
      "clause": "5.5.1",
      "category": "performance",
      "requirement_text": "Horizontal peripheral field of vision shall be at least 105 degrees each side, upward at least 7 degrees and downward at least 45 degrees.",
